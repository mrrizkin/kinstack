{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "KinStack: Debug backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/kinstack",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev",
      "showLog": true,
      "preLaunchTask": "KinStack: start infrastructure"
    },
    {
      "name": "KinStack: Debug backend (no prelaunch)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/kinstack",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "showLog": true
    }
  ]
}
