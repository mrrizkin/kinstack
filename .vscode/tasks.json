{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KinStack: start infrastructure",
      "type": "shell",
      "command": "just dev-infra-up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "KinStack: frontend dev server",
      "type": "shell",
      "command": "bun x vite",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": ".*" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*"
        }
      }
    }
  ]
}
