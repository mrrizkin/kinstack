# --- Application -----------------------------------------------------------
APP_NAME=KinStack
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
SESSION_IDLE_TIMEOUT=24h
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m
# Lock an account temporarily after 5 failures within 15 minutes.
AUTH_LOCKOUT_MAX=5
AUTH_LOCKOUT_WINDOW=15m
API_RATE_LIMIT_MAX=240
API_RATE_LIMIT_WINDOW=1m
# Request body limit (MB) must be larger than the 10 MiB media upload limit.
APP_BODY_LIMIT_MB=12
# Reverse proxies whose X-Forwarded-* headers are trusted, as IPs or CIDRs
# (comma separated). Private and loopback peers are trusted in production
# automatically; add a load balancer here when it answers from a public address,
# otherwise every client shares one rate-limit bucket and one audit IP.
TRUSTED_PROXIES=
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# --- Container image (deploy) ---------------------------------------------
# Container image tag used by docker compose. Releases are cut by pushing a tag
# (`just tag && git push origin <tag>`), named v<YEAR>.<WEEK>.<PATCH>; the
# workflow publishes that tag and latest.
IMAGE_TAG=latest

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug
LOG_CONSOLE=true
LOG_FILE=true
LOG_DIR=storage/logs
LOG_NAME=kinstack
LOG_MAX_BACKUP=20
LOG_MAX_SIZE=50
LOG_MAX_AGE=7

# The credential defaults below are for local development only. They are
# rejected when APP_ENV=production; run `just setup-secrets` to replace them
# with generated values.

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://kinstack:kinstack@localhost:5433/kinstack?sslmode=disable
POSTGRES_DB=kinstack
POSTGRES_USER=kinstack
POSTGRES_PASSWORD=kinstack
DB_STATEMENT_TIMEOUT=15s
# Pool size. Keep max_conns below the PostgreSQL max_connections budget of
# every replica sharing the database.
DB_MAX_CONNS=10
DB_MAX_IDLE_CONNS=5

# --- Valkey (sessions) -----------------------------------------------------
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DATABASE=0
VALKEY_PASSWORD=kinstack-local-password

# --- Super admin (break-glass) --------------------------------------------
# ACCESS_KEY = username, SECRET_KEY = password. Checked before the database,
# like basic auth; it does not create an account. Use a random value of at least 32 characters.
ACCESS_KEY=superadmin
# Local development only; `just setup-secrets` replaces it with a random value.
SECRET_KEY=replace-with-random-secret-at-least-32-characters

# --- PDF documents (Gotenberg) ---------------------------------------------
# Leave GOTENBERG_URL empty to disable server-side PDF rendering.
GOTENBERG_URL=http://localhost:3010
DOCUMENT_TIMEOUT=30s

# --- Email (SMTP) ----------------------------------------------------------
# Leave SMTP_HOST empty to disable email delivery. In development, the
# Mailpit service from `just infra-up` captures mail at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=KinStack <no-reply@kinstack.local>
# Optional credentials; set both when the relay requires authentication.
SMTP_USERNAME=
SMTP_PASSWORD=

# Authentication methods. Flags only toggle behavior.
# An enabled method with incomplete settings fails fast at startup.
AUTH_MAGIC_LINK_ENABLED=true
AUTH_PASSWORD_RESET_ENABLED=true
AUTH_PASSKEY_ENABLED=true
AUTH_API_TOKEN_ENABLED=true

# OAuth state signing secret. Required (>=32 bytes) when an OAuth provider is enabled.
AUTH_STATE_SECRET=

# Envelope key for TOTP secrets at rest (>=32 bytes). Leave empty to derive it
# from SECRET_KEY; set a dedicated value to rotate the two independently.
# Changing it after users enrolled makes their stored secrets unreadable.
AUTH_2FA_KEY=

# Generic OIDC.
AUTH_OIDC_ENABLED=false
AUTH_OIDC_NAME=SSO
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_AUTH_URL=
AUTH_OIDC_TOKEN_URL=
AUTH_OIDC_USERINFO_URL=

# Social providers (goth).
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

AUTH_APPLE_ENABLED=false
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_CLIENT_SECRET=

AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=

AUTH_GITHUB_ENABLED=false
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# SAML 2.0 service provider.
AUTH_SAML_ENABLED=false
AUTH_SAML_ENTITY_ID=
AUTH_SAML_IDP_METADATA_URL=
AUTH_SAML_CERT=
AUTH_SAML_KEY=

# --- Media / object storage ------------------------------------------------
# Enables the media slice. When true, every RUSTFS_* setting below must be
# valid or the application panics at startup.
MEDIA_ENABLED=false
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=kinstack
RUSTFS_REGION=us-east-1
RUSTFS_USE_SSL=false

# --- Local observability stack ---------------------------------------------
# `just infra-up` starts GlitchTip, Umami, and OpenObserve alongside the core
# services. Open the UIs at:
#   GlitchTip   http://localhost:8000
#   Umami       http://localhost:3003
#   OpenObserve http://localhost:5080
# These secrets are local development defaults only.
GLITCHTIP_SECRET_KEY=local-glitchtip-secret-change-me
UMAMI_APP_SECRET=local-umami-secret-change-me
UMAMI_TWO_FACTOR_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OPENOBSERVE_ROOT_EMAIL=root@kinstack.local
OPENOBSERVE_ROOT_PASSWORD=KinStack!2026

# --- Error tracking (GlitchTip, Sentry-compatible) -------------------------
# Leave GLITCHTIP_DSN empty to disable. The DSN is also exposed to the browser
# as an Inertia prop, so it must be a public DSN.
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=
GLITCHTIP_RELEASE=
GLITCHTIP_TRACES_SAMPLE_RATE=0
GLITCHTIP_DEBUG=false

# --- Analytics (Umami) -----------------------------------------------------
# The tracker observes History API changes, so Inertia page views are recorded
# without extra calls. UMAMI_DOMAINS is an optional comma-separated allowlist.
UMAMI_ENABLED=false
# For the local stack, use http://localhost:3003/script.js
UMAMI_SCRIPT_URL=https://umami.example.com/script.js
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=
UMAMI_AUTO_TRACK=true

# --- Observability (OpenObserve via OTLP/HTTP) -----------------------------
# OPENOBSERVE_AUTH_HEADER is the full Authorization value, for example
# "Basic $(printf '%s' 'email:password' | base64)" or "Bearer <token>".
# Required in production. OPENOBSERVE_ENDPOINT must not end with a slash.
OPENOBSERVE_ENABLED=false
OPENOBSERVE_ENDPOINT=http://localhost:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_AUTH_HEADER=
# For the local stack: Basic cm9vdEBraW5zdGFjay5sb2NhbDpLaW5TdGFjayEyMDI2
OPENOBSERVE_STREAM=kinstack
OPENOBSERVE_SERVICE_NAME=kinstack
OPENOBSERVE_ENVIRONMENT=
OPENOBSERVE_RELEASE=
OPENOBSERVE_TRACES_SAMPLE_RATE=1
OPENOBSERVE_EXPORT_LOGS=true
OPENOBSERVE_EXPORT_METRICS=true
OPENOBSERVE_INSECURE=false

# --- Content Security Policy -----------------------------------------------
# Defaults to enabled when APP_ENV=production. Leave unset in development so
# Vite HMR keeps working. Extra sources are comma-separated CSP source values.
CSP_ENABLED=
CSP_REPORT_ONLY=false
CSP_REPORT_URI=/csp-report
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
# Avatars are rendered by the DiceBear API.
CSP_EXTRA_IMG_SRC=https://api.dicebear.com
